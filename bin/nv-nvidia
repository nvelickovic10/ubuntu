#!/bin/bash
# Switches which GPU drives the internal display from boot (takes effect after reboot)

SCRIPT_DESC="Usage: nv-nvidia on|off|status (on: NVIDIA drives the display, HDMI works; off: Intel drives it, NVIDIA is powered off; both need a reboot)"
commons_dir="$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )/common"
EFIVAR="/sys/firmware/efi/efivars/gpu-power-prefs-fa4ce28d-b62f-4c99-9cc3-6815686e30f9"
VALUE_NVIDIA="00"
VALUE_INTEL="01"
SERVICE="nvidia-off.service"

# Include common functions
. ${commons_dir}/common.sh

# Include root functions
. ${commons_dir}/sudoUtil.sh

# Prints the variable as hex (attributes + value), or nothing when it cannot be read.
# After a boot the variable is not listed at all, and right after a write it exists but reads fail with EINVAL until the next boot.
function efivarHex {
    { od -An -tx1 -v < "${EFIVAR}" | tr -d ' \n'; } 2>/dev/null
}

function serviceEnabled {
    [ "$(systemctl is-enabled "${SERVICE}" 2>/dev/null)" = "enabled" ]
}

# Prints the kernel driver of the GPU whose eDP connector is connected right now
function currentDisplayDriver {
    local CONNECTOR
    for CONNECTOR in /sys/class/drm/card*-eDP-*; do
        if [ "$(cat "${CONNECTOR}/status" 2>/dev/null)" = "connected" ]; then
            basename "$(readlink -f "${CONNECTOR}/../device/driver")"
            return
        fi
    done
    echo "unknown"
}

# With "pending" (called after on/off) the display still runs on the old GPU until the reboot, so the service check is skipped
function status {
    local PENDING="${1:-}"
    local DRIVER HEX
    DRIVER=$(currentDisplayDriver)
    HEX=$(efivarHex)
    logInfo "Now: display on ${DRIVER} ($( [ "${DRIVER}" = "nouveau" ] && echo NVIDIA || echo Intel ))"
    logInfo "gpu-power-prefs: ${HEX:-not readable (normal after a boot and right after a write; the firmware keeps it, so judge by the running display)}"
    logInfo "${SERVICE}: $( serviceEnabled && echo enabled || echo disabled )"
    if [ -n "${PENDING}" ]; then
        logInfo "Reboot pending: the display changes only after the next boot"
    elif [ "${DRIVER}" = "nouveau" ] && serviceEnabled; then
        logError "${SERVICE} is enabled while NVIDIA drives the display: it must not be. Run nv-nvidia on"
    fi
}

# Writes the display preference the firmware reads at boot: 01 = Intel (integrated), 00 = NVIDIA (discrete).
# Deleting the variable does not work (it is not visible after a boot, though the firmware still holds it), so both modes write a value.
function writePrefs {
    local VALUE="$1"
    local EXPECTED="07000000${VALUE}000000"
    local HEX
    # Remove any leftover (even broken) variable, then write attributes + value with tee (the way that worked on 2026-10-08)
    runAsSudo "if [ -e ${EFIVAR} ]; then chattr -i ${EFIVAR}; rm ${EFIVAR}; fi; printf \"\\x07\\x00\\x00\\x00\\x${VALUE}\\x00\\x00\\x00\" | tee ${EFIVAR} > /dev/null"
    if [ ! -e "${EFIVAR}" ]; then
        logError "Could not write ${EFIVAR}"
        exit 1
    fi
    HEX=$(efivarHex)
    if [ -n "${HEX}" ] && [ "${HEX}" != "${EXPECTED}" ]; then
        logError "${EFIVAR##*/} reads ${HEX}, expected ${EXPECTED}"
        exit 1
    fi
    logInfo "Wrote ${EFIVAR##*/} = ${EXPECTED} (it cannot be read back before the next reboot)"
}

# Service goes first so the GPU that drives the display is never powered off by mistake.
function nvidiaOn {
    runAsSudo "systemctl disable ${SERVICE}"
    if serviceEnabled; then
        logError "${SERVICE} is still enabled, aborting before touching the EFI variable"
        exit 1
    fi
    writePrefs "${VALUE_NVIDIA}"
    logInfo "NVIDIA mode set: HDMI works, higher temperature and power use"
    logInfo "Reboot to apply, then check: nv-nvidia status (display on nouveau). If the monitor stays disconnected: echo detect | sudo tee /sys/class/drm/card1-HDMI-A-1/status"
}

# The variable goes first so the service is never enabled while NVIDIA still drives the display
function nvidiaOff {
    writePrefs "${VALUE_INTEL}"
    runAsSudo "systemctl enable ${SERVICE}"
    logInfo "Intel mode set: NVIDIA is powered off after boot, HDMI does not work"
    logInfo "Reboot to apply, then check: glxinfo -B | grep renderer (expected Intel Iris Pro P5200)"
}

case "${1:-}" in
    on) nvidiaOn ;;
    off) nvidiaOff ;;
    status) status ;;
    *)
        logError "Usage: nv-nvidia on|off|status"
        exit 1
        ;;
esac
[ "${1}" = "status" ] || status pending
