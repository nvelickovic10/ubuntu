#!/bin/bash
# Enables or disables Intel Turbo Boost (until reboot)

SCRIPT_DESC="Usage: nv-turbo on|off (enables or disables Intel Turbo Boost until reboot)"
commons_dir="$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )/common"
NO_TURBO="/sys/devices/system/cpu/intel_pstate/no_turbo"

# Include common functions
. ${commons_dir}/common.sh

# Include root functions
. ${commons_dir}/sudoUtil.sh

# intel_pstate: no_turbo=0 enables Turbo Boost, 1 disables it
case "${1:-}" in
    on) runAsSudo "echo 0 > ${NO_TURBO}" ;;
    off) runAsSudo "echo 1 > ${NO_TURBO}" ;;
    *)
        logError "Usage: nv-turbo on|off"
        exit 1
        ;;
esac
logInfo "Turbo Boost: $( [ "$(cat ${NO_TURBO})" = 0 ] && echo ON || echo OFF )"
