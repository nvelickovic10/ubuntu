#!/bin/bash
# Runs a script Claude Code left in $XDG_RUNTIME_DIR/claude-scripts (run-<session>.sh; the newest one unless a path is given)

SCRIPT_DESC="Usage: nv-claude-sh [script] (runs the newest \$XDG_RUNTIME_DIR/claude-scripts/run-*.sh Claude Code prepared, or the given script)"
commons_dir="$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )/common"
RUN_SH="${1:-$(ls -t "${XDG_RUNTIME_DIR:-/nonexistent}"/claude-scripts/run-*.sh 2>/dev/null | head -n 1)}"

# Include common functions
. ${commons_dir}/common.sh

if [ -z "${RUN_SH}" ] || [ ! -f "${RUN_SH}" ]; then
    logError "no Claude script found in ${XDG_RUNTIME_DIR:-\$XDG_RUNTIME_DIR}/claude-scripts"
    exit 1
fi

bash "${RUN_SH}"
