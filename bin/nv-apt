#!/bin/bash
# This script will clean apt 
#
# Maintenance wrapper around apt and snap. Usage: nv-apt [--all | --clean | --update | --upgrade | --status | --switch | --help]
#   --all, --a (default)  update, dist-upgrade -y, autoremove/autoclean/clean -y, then snap refresh; stops at the first failure
#   --update, --u         apt update && apt list --upgradable
#   --upgrade, --U        apt dist-upgrade (interactive)
#   --clean, --rm         apt autoremove && apt autoclean && apt clean (interactive)
#   --status, --s         reports whether the private sources in PRIVATE_SOURCES (tor.list) are active in
#                         /etc/apt/sources.list.d ("work settings") or hidden as .tor.list ("personal settings")
#   --switch, --S         toggles those sources by renaming X.list <-> .X.list, then runs --status
#
# Only --all passes -y (ASSUME_YES). It used to pipe `yes` into each step and hung (pipe on stdin + sudo-rs, Ubuntu's
# current sudo); -y instead of the pipe is tested with real sudo and works. Don't reintroduce `yes |` or eval pipelines.
# Pass flags to apt through ASSUME_YES and keep each action a separate fn_* function selected by ACTION.

SCRIPT_DESC="This script will clean apt"
commons_dir="$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )/common"

# Include common functions
. ${commons_dir}/common.sh

# Include root functions
. ${commons_dir}/sudoUtil.sh

SOURCES_DIR="/etc/apt/sources.list.d"
PRIVATE_SOURCES="tor.list"

function printHelpAndExit {
    echo "USAGE"
    echo "  ${SCRIPT_NAME} [--all | --clean | --update | --upgrade | --status | --switch]"
    echo
    echo "DESCRIPTION"
    echo "  ${SCRIPT_DESC}"
    echo
    echo "OPTIONS"
    echo "  --all, --a            : Select update && upgrade && clean (default)"
    echo "  --clean,  --rm        : Select clean"
    echo "  --update, --u         : Select update action"
    echo "  --upgrade, --U        : Select upgrade action"
    echo "  --status, --s         : Select status action"
    echo "  --switch, --S         : Select switch action"
    echo
    echo "  --help,   --h         : Show this help (default)"
    exit 1
}

function fn_all {
    logInfo "Running ALL command: update && upgrade && clean && snap"
    ASSUME_YES="-y"
    fn_update && fn_upgrade && fn_clean && fn_snap
}

function fn_clean {
    local COMMAND="apt ${ASSUME_YES} autoremove && apt ${ASSUME_YES} autoclean && apt ${ASSUME_YES} clean"
    logInfo "Running CLEAN command: ${COMMAND}"
    runAsSudo "${COMMAND}"
}

function fn_update {
    local COMMAND="apt update && apt list --upgradable"
    logInfo "Running UPDATE command: ${COMMAND}"
    runAsSudo "${COMMAND}"
}

function fn_upgrade {
    local COMMAND="apt ${ASSUME_YES} dist-upgrade"
    logInfo "Running UPGRADE command: ${COMMAND}"
    runAsSudo "${COMMAND}"
}

function fn_status {
    logInfo "Running STATUS command"
    for SOURCE in ${PRIVATE_SOURCES} ; do
        if [ -e "${SOURCES_DIR}/${SOURCE}" ]
        then
            logInfo "Source: ${SOURCE} is on work settings"
        else
            logInfo "Source: ${SOURCE} is on personal settings"
        fi
    done
}

function fn_snap {
    local COMMAND="snap refresh"
    logInfo "Running SNAP command: ${COMMAND}"
    runAsSudo "${COMMAND}"
}

function fn_switch {
    logInfo "Running SWITCH command: ${COMMAND}"
    for SOURCE in ${PRIVATE_SOURCES} ; do
        if [ -e "${SOURCES_DIR}/${SOURCE}" ]
        then
            local COMMAND="mv ${SOURCES_DIR}/${SOURCE} ${SOURCES_DIR}/.${SOURCE}"
            logInfo "Switching: ${SOURCES_DIR}/${SOURCE} to personal settings"
        else
            local COMMAND="mv ${SOURCES_DIR}/.${SOURCE} ${SOURCES_DIR}/${SOURCE}"
            logInfo "Switching: ${SOURCES_DIR}/${SOURCE} to work settings"
        fi
        runAsSudo "${COMMAND}"
    done
    fn_status
}

ASSUME_YES=""
ACTION="fn_all"
# Parsing command line arguments
for arg; do
    case "${arg}" in
        --all|--a)
            ACTION="fn_all"
        ;;
        --clean|--rm)
            ACTION="fn_clean"
        ;;
        --update|--u)
            ACTION="fn_update"
        ;;
        --upgrade|--U)
            ACTION="fn_upgrade"
        ;;
        --status|--s)
            ACTION="fn_status"
        ;;
        --switch|--S)
            ACTION="fn_switch"
        ;;
        --help)
            printHelpAndExit
        ;;
    esac
done

logInfo "ACTION: ${ACTION}"
eval ${ACTION}

# End
